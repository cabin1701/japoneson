---
// じぃチャット窓（RAG）。site/blog の VegaChat.astro と同じ構造の移植版。
// 中身の検索は /api/chat（functions/api/chat.ts）→ Vectorize `japoneson-2026`。
interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props as Props;

const copy: Record<string, { label: string; headerTitle: string; placeholder: string; greeting: string; send: string }> = {
  en: {
    label: 'Talk to Jii',
    headerTitle: 'Jii - oldman',
    placeholder: 'Say something...',
    greeting: "Call me Jii... old Japanese fella, that's what I am... mind's slippin' a bit these days, y'know... but go on, ask me somethin'.",
    send: 'Send',
  },
  es: {
    label: 'Habla con Jii',
    headerTitle: 'Jii - viejito',
    placeholder: 'Dime algo...',
    greeting: 'Llámame Jii... soy solo un viejito japonés... la cabeza ya no anda tan fina estos días, ¿sabes? pero anda, pregúntame lo que quieras.',
    send: 'Enviar',
  },
};
const t = copy[lang] ?? copy.en;
---

<div id="jii-chat-root" data-lang={lang} data-greeting={t.greeting} data-placeholder={t.placeholder} data-send={t.send}>
  <button id="jii-chat-toggle" aria-label={t.label} type="button">
    <span id="jii-chat-toggle-icon">👴</span>
  </button>

  <div id="jii-chat-panel" hidden>
    <div id="jii-chat-header">
      <span>{t.headerTitle}</span>
      <button id="jii-chat-close" aria-label="close" type="button">×</button>
    </div>
    <div id="jii-chat-messages"></div>
    <form id="jii-chat-form">
      <input id="jii-chat-input" type="text" autocomplete="off" />
      <button type="submit">{t.send}</button>
    </form>
  </div>
</div>

<style>
  #jii-chat-root {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9999;
    font-family: var(--font-display-lora, 'Lora', serif);
  }

  #jii-chat-toggle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-accent, #7a3b12);
    color: #fff;
    border: none;
    font-size: 24px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  #jii-chat-panel {
    position: absolute;
    bottom: 68px;
    right: 0;
    width: min(340px, 90vw);
    height: min(460px, 70vh);
    background: var(--color-bg, #fffdf4);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  #jii-chat-panel[hidden] {
    display: none;
  }

  #jii-chat-header {
    background: var(--color-accent, #7a3b12);
    color: #fff;
    padding: 10px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
  }

  #jii-chat-close {
    background: none;
    border: none;
    color: #fff;
    font-size: 20px;
    cursor: pointer;
    line-height: 1;
  }

  #jii-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* JS が実行時に作る要素なのでスコープが効かない。子だけ :global() で抜く（VegaChatと同じ理由） */
  #jii-chat-messages :global(.jii-msg) {
    max-width: 85%;
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.5;
    white-space: pre-wrap;
  }

  #jii-chat-messages :global(.jii-msg.user) {
    align-self: flex-end;
    background: var(--color-accent, #7a3b12);
    color: #fff;
  }

  #jii-chat-messages :global(.jii-msg.jii) {
    align-self: flex-start;
    background: rgba(0, 0, 0, 0.06);
    color: var(--color-text, #333);
  }

  #jii-chat-messages :global(.jii-msg.loading) {
    opacity: 0.6;
    font-style: italic;
  }

  #jii-chat-messages :global(.jii-sources) {
    margin-top: 6px;
    font-size: 12px;
    opacity: 0.8;
  }

  #jii-chat-messages :global(.jii-sources a) {
    color: var(--color-accent, #7a3b12);
  }

  #jii-chat-form {
    display: flex;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  #jii-chat-input {
    flex: 1;
    border: none;
    padding: 10px 12px;
    font-size: 14px;
    background: transparent;
    color: var(--color-text, #333);
  }

  #jii-chat-input:focus {
    outline: none;
  }

  #jii-chat-form button[type='submit'] {
    border: none;
    background: var(--color-accent, #7a3b12);
    color: #fff;
    padding: 0 16px;
    cursor: pointer;
    font-size: 14px;
  }
</style>

<script>
  const root = document.getElementById('jii-chat-root') as HTMLElement;
  const toggle = document.getElementById('jii-chat-toggle') as HTMLButtonElement;
  const panel = document.getElementById('jii-chat-panel') as HTMLElement;
  const closeBtn = document.getElementById('jii-chat-close') as HTMLButtonElement;
  const messagesEl = document.getElementById('jii-chat-messages') as HTMLElement;
  const form = document.getElementById('jii-chat-form') as HTMLFormElement;
  const input = document.getElementById('jii-chat-input') as HTMLInputElement;

  const placeholder = root.dataset.placeholder ?? '';
  const greeting = root.dataset.greeting ?? '';
  input.placeholder = placeholder;

  let greeted = false;

  function addMessage(role: 'user' | 'jii', text: string, sources?: { title: string; url: string }[]) {
    const el = document.createElement('div');
    el.className = `jii-msg ${role}`;
    el.textContent = text;
    if (sources && sources.length) {
      const src = document.createElement('div');
      src.className = 'jii-sources';
      src.innerHTML = sources
        .map((s) => `▪︎ <a href="${s.url}" target="_blank" rel="noopener">${s.title}</a>`)
        .join('<br />');
      el.appendChild(src);
    }
    messagesEl.appendChild(el);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return el;
  }

  toggle.addEventListener('click', () => {
    const isHidden = panel.hasAttribute('hidden');
    if (isHidden) {
      panel.removeAttribute('hidden');
      if (!greeted) {
        addMessage('jii', greeting);
        greeted = true;
      }
      input.focus();
    } else {
      panel.setAttribute('hidden', '');
    }
  });

  closeBtn.addEventListener('click', () => panel.setAttribute('hidden', ''));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const message = input.value.trim();
    if (!message) return;
    addMessage('user', message);
    input.value = '';
    input.disabled = true;

    const loadingEl = addMessage('jii', '...');
    loadingEl.classList.add('loading');

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message }),
      });
      const data = await res.json();
      loadingEl.remove();
      addMessage('jii', data.answer ?? '', data.sources);
    } catch {
      loadingEl.remove();
      addMessage('jii', "Eh... something's gone wrong. Try again, y'know.");
    } finally {
      input.disabled = false;
      input.focus();
    }
  });
</script>
