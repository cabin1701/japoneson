---
interface Crumb {
  slug: string;
  title: string;
  path: string;
}
interface Props {
  trail: Crumb[];
  lang?: 'en' | 'es' | 'ja';
}
const { trail, lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = `${base}${lang === 'ja' ? 'en' : lang}/`;
// 画面のパンくずと同じ中身を、構造化データ（BreadcrumbList）でも出す。
// AI や検索エンジンに「どのセクションの中のページか」を伝えるため（2026-11-13）
const abs = (p: string) => new URL(p, Astro.site).href;
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    // 日本語は /ja/ のトップがないので HOME を出さず、めんたいロックから始める（2026-11-18）
    ...(lang === 'ja' ? [] : [{ '@type': 'ListItem', position: 1, name: 'HOME', item: abs(home) }]),
    ...trail.map((c, i) => ({
      '@type': 'ListItem',
      position: i + (lang === 'ja' ? 1 : 2),
      name: c.title,
      item: i === trail.length - 1 ? abs(Astro.url.pathname) : abs(c.path),
    })),
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

<nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
  <ol>
    {lang !== 'ja' && <li><a href={home}>HOME</a></li>}
    {trail.slice(0, -1).map((c) => (
      <li><a href={c.path}>{c.title}</a></li>
    ))}
    {trail.length > 0 && (
      <li aria-current="page">{trail[trail.length - 1].title}</li>
    )}
  </ol>
</nav>

<style>
  .breadcrumb {
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: #666;
  }
  ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  li:not(:last-child)::after {
    content: ' > ';
    margin-left: 0.3rem;
    color: #999;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  [aria-current='page'] {
    color: #222;
  }
</style>
