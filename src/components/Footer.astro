---
interface Props {
  lang?: 'en' | 'es' | 'ja';
}
const { lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = `${base}${lang === 'ja' ? 'en' : lang}/`;
const contactHref = lang === 'ja' ? `${base}ja/contact/` : `${base}contact/`;
const legalPrefix = `${base}${lang}/`; // 日本語は、プライバシーと利用規約も /ja/ に置いた（2026-11-18）

const t = lang === 'ja'
  ? { tagline: 'ONLY MUSIC IS INCAPABLE OF LYING TO ME.', contact: 'お問い合わせ', privacy: 'プライバシーポリシー', terms: '利用規約', books: '本' }
  : lang === 'es'
  ? { tagline: 'SOLO LA MÚSICA ES INCAPAZ DE MENTIRME.', contact: 'Contacto', privacy: 'Política de privacidad', terms: 'Términos de uso', books: 'Libros' }
  : { tagline: 'ONLY MUSIC IS INCAPABLE OF LYING TO ME.', contact: 'Contact', privacy: 'Privacy Policy', terms: 'Terms of use', books: 'Books' };
---

<footer class="site-footer" data-pagefind-ignore>
  <hr class="rule" />
  <div class="container">
    <p class="footer-tagline">{t.tagline}</p>
    <ul class="footer-nav">
      <li><a href={contactHref}>{t.contact}</a></li>
      <li><a href={`${legalPrefix}privacy-policy/`}>{t.privacy}</a></li>
      <li><a href={`${legalPrefix}terms-and-conditions/`}>{t.terms}</a></li>
      {lang !== 'ja' && <li><a href="https://cabin1701.com/books/">{t.books}</a></li>}
      {lang !== 'ja' && <li><a href={`${prefix}cupie/`}>Cupie Danny</a></li>}
    </ul>
    <p class="footer-copy">&copy; {new Date().getFullYear()} Shoko "Seina" Shiraishi</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding-bottom: 2rem;
  }
  .footer-nav {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .footer-nav a {
    font-family: var(--font-nav);
    font-size: 1rem;
    color: var(--color-text);
    text-decoration: none;
  }
  .footer-nav a:hover { color: var(--color-accent); }
  .footer-tagline {
    text-align: center;
    font-family: cinzel;
    font-weight: 500;
    font-size: 1.40rem;
    color: var(--color-accent);
    letter-spacing: 0.04em;
    margin: 1.5rem 0 0.5rem;
  }
  .footer-copy {
    text-align: center;
    font-family: var(--font-display-serif);
    font-style: italic;
    color: var(--color-muted);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
