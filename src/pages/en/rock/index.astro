    text-align: center;
    line-height: 1.3;
    margin: 1rem 0 1.5rem;
  }
  .intro-inner p.sub-q {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 18px;
    color: var(--color-navy);
    text-align: center;
    margin: 0.3rem 0;
  }
