---
import { rockJsonLd } from '../../../../data/rockJsonLd';
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import ProjectHero from '../../../../components/ProjectHero.astro';

const base = import.meta.env.BASE_URL;
const IMG = (p: string) => `/images/wp/${p}`;

interface KCard {
  title: string;
  image: string;
  alt: string;
  desc: string;
  href: string;
}

const koreanWar: KCard[] = [
  {
    title: 'The Shadow of Kokura — The Black Soldiers',
    image: IMG('2026/04/blacksoldiers-600x573.jpg'),
    alt: 'The Black Soldiers',
    desc: 'A quiet prayer for the soldiers who crossed the Kanmon Strait, and never came home.',
    href: `${base}en/mystery/macarthur/korea-black-soldiers/`,
  },
  {
    title: 'The 24th Infantry Division',
    image: IMG('2026/04/TL-WINTER-13-D-1-600x600.jpg'),
    alt: 'The 24th Infantry Division',
    desc: 'For the boys who left Kyushu and never looked back—this is a prayer for what they carried.',
    href: `${base}en/mystery/macarthur/korea-24th/`,
  },
  {
    title: 'David Valley',
    image: IMG('2026/04/IMG_2028-02-600x601.jpg'),
    alt: 'David Valley',
    desc: 'The last guardian of a fading era—who passed the invisible baton to a maverick from Japan.',
    href: `${base}en/mystery/macarthur/david-valley/`,
  },
  {
    title: 'Monica Lewis',
    image: IMG('2026/04/korea1.jpg'),
    alt: 'Monica Lewis',
    desc: 'In 1951, my friend Ms. Monica Lewis (1922-2015) entertained "for the boys" who served in the Korean War with Danny Kaye.',
    href: `${base}en/swing/for-the-boys/`,
  },
];

const trail = [
  { slug: 'rock', title: 'MENTAI ROCK', path: `${base}en/rock/` },
  { slug: 'two-pillars', title: 'THE TWO PILLARS', path: `${base}en/rock/two-pillars/` },
];
---

<Layout title="The Two Pillars: Sheena & The Rokkets and The Roosters — Japonéson" description={`Sheena & The Rokkets and The Roosters, the two pillars of Mentai Rock: how Makoto Ayukawa, Sheena, and Shinya Oe shaped the rock of Fukuoka and Kitakyushu.`} lang="en" jsonLd={rockJsonLd({ lang: "en", path: "/en/rock/two-pillars/", title: 'The Two Pillars: Sheena & The Rokkets and The Roosters — Japonéson', description: `Sheena & The Rokkets and The Roosters, the two pillars of Mentai Rock: how Makoto Ayukawa, Sheena, and Shinya Oe shaped the rock of Fukuoka and Kitakyushu.` })} ogImage="images/rock/pillars-hero.jpg">
  <Header lang="en" />
  <main class="rock-main">
    <ProjectHero
      title="The Two Pillars"
      subtitle="Sheena & The Rokkets and The Roosters"
      titleFont="var(--font-display-cinzel)"
      titleWeight={700}
      titleSize="60px"
      titleColor="#e02a46"
      image={`${base}images/rock/pillars-hero.jpg`}
      imageAlt={`Makoto Ayukawa holding his Gibson Les Paul backstage beside a Sheena & The Rokkets T-shirt. Photo by FU.`}
      align="center"
      height={1000}
      fit="cover"
      overlayTop={0}
      overlayBottom={0}
    />

    <div class="container breadcrumb-wrap">
      <Breadcrumb trail={trail} lang="en" />
    </div>

    <section class="takano">
      <div class="tk-inner">
        <h2 class="tk-h2" id="sheena-rokkets">1. Sheena &amp; The Rokkets</h2>
        <p>Sheena & The Rokkets was formed in 1978 by guitarist Makoto Ayukawa—originally from Kurume and formerly of the legendary Fukuoka blues-rock band Sonhouse—and vocalist Sheena, who hailed from Wakamatsu, Kitakyushu. Their partnership joined Ayukawa’s roots in Kurume and Fukuoka with Sheena’s family and cultural roots in Kitakyushu, and from that bond of music, family, and place, Sheena & The Rokkets was born. They brought raw rhythm & blues, rock 'n' roll, and boundless warmth from Kitakyushu and Fukuoka to the world. As Seina recalls, if The Roosters were born out of struggle and raw friction, Sheena & The Rokkets were pure <em>"Love"</em> —music rooted across Kurume, Fukuoka, and Kitakyushu that welcomed every generation onto the dance floor.</p>
        <div style="max-width:560px;margin:1.5rem auto 2rem;">
          <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;">
            <iframe src="https://www.youtube.com/embed/BF1-dFfn2T0" title="Sheena &amp; The Rokkets — Lemon Tea" style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
          </div>
        </div>
        <h2 class="tk-h2" id="roosters">2. The Roosters</h2>
        <p>Emerging from the steelworks and port city of Kitakyushu in 1979, The Roosters—Shinya Oe, Hiroyuki Hanada, Tomio Inoue, and Junji Ikehata—became the untamed, electric spark that defined "Mentai Rock." As former <em>Oira no Machi</em> editor Keiichi Takano testifies, they rejected commercial polish and television stardom in favor of pure, uncompromising working-class blues—a sound so fiercely original that decades later, bands from Kitakyushu still cover their songs as an encore in Tokyo.</p>
        <div style="max-width:560px;margin:1.5rem auto 2rem;">
          <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;">
            <iframe src="https://www.youtube.com/embed/9znrR3CJmYc" title="The Roosters — C.M.C." style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer lang="en" />
</Layout>

<style>
  .takano { padding: 1.5rem 1.25rem 3rem; }
  .tk-inner { max-width: 780px; margin: 0 auto; font-family: Helvetica, Arial, sans-serif; font-size: 17px; line-height: 1.8; color: #2a2a2a; }
  .tk-inner p { margin: 0 0 1.1rem; }
  .tk-inner strong { color: var(--color-accent); font-weight: 700; }
  .tk-lead { display: grid; grid-template-columns: 180px 1fr; gap: 1.5rem; align-items: start; margin: 0 0 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid #ccc; }
  .tk-lead img { width: 100%; height: auto; display: block; }
  .tk-lead p { font-style: italic; color: #020450; }
  .tk-h2 { font-family: var(--font-section); font-weight: 700; font-size: 24px; color: #020450; margin: 2.5rem 0 1rem; }
  @media (max-width: 640px) { .tk-lead { grid-template-columns: 1fr; } .tk-lead img { max-width: 200px; } }
  .voice-text .voice-h3 { font-family: var(--font-section); font-weight: 700; font-size: 20px; color: #020450; margin: 2rem 0 0.6rem; }
  .voice-text p.voice-more a { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid currentColor; }
  .voice-cards { max-width: 1000px; margin: 1rem auto 2rem; padding: 0 1.25rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .voice-card { display: block; text-decoration: none; color: inherit; background: #000; }
  .voice-card img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center top; display: block; }
  .voice-card .vc-body { padding: 14px 16px 18px; }
  .voice-card .vc-name { font-family: var(--font-display-cinzel); font-weight: 700; font-size: 22px; color: var(--color-accent); margin: 0 0 6px; }
  .voice-card .vc-line { font-family: Helvetica, Arial, sans-serif; font-style: italic; font-size: 15px; line-height: 1.5; color: #eee; margin: 0; }
  .voice-card:hover img { filter: brightness(1.1); }
  @media (max-width: 640px) { .voice-cards { grid-template-columns: 1fr; } }
  .voice { padding: 2.5rem 1.25rem; border-bottom: 1px solid #ccc; }
  .voice-inner { max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: 260px 1fr; gap: 2rem; align-items: start; }
  .voice-photo { aspect-ratio: 4 / 5; background: #ddd; }
  .voice-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .voice-name { font-family: var(--font-display-cinzel); font-weight: 700; font-size: 30px; color: var(--color-accent); margin: 0 0 1rem; }
  .voice-text p { font-family: Helvetica, Arial, sans-serif; font-size: 17px; line-height: 1.75; color: #2a2a2a; }
  @media (max-width: 640px) { .voice-inner { grid-template-columns: 1fr; } }
  .industrial { padding: 0 1.25rem 2rem; }
  .industrial .intro-inner p.ind-sub { font-family: var(--font-display-cinzel); font-weight: 600; font-size: 22px; color: #020450; text-align: center; margin: -0.8rem 0 0.8rem; }
  .industrial .ind-h3 { font-family: var(--font-section); font-weight: 700; font-size: 22px; color: var(--color-accent); margin: 2rem 0 0.8rem; }
  .ind-table-wrap { overflow-x: auto; margin: 0 0 1.5rem; }
  .ind-table { width: 100%; border-collapse: collapse; font-family: Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.5; color: #2a2a2a; }
  .ind-table th { background: #020450; color: #fff; text-align: left; padding: 8px 10px; font-weight: 700; }
  .ind-table td { border-bottom: 1px solid #ccc; padding: 10px; vertical-align: top; }
  .ind-table tr:last-child td { background: rgba(224,42,70,0.08); }
  .rock-maps { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 0 0 2rem; }
  .rock-maps img { width: 100%; height: auto; display: block; }
  @media (max-width: 640px) { .rock-maps { grid-template-columns: 1fr; } }
  .intro-inner p.signature { text-align: right; font-style: italic; }
  .rock-main { --color-accent: #e02a46; }
  .motto { text-align: center; margin: 0.5rem auto 2rem; max-width: 760px; }
  .intro-inner p.motto-ja { font-family: "Noto Sans JP", sans-serif; font-weight: 900; font-size: 20px; line-height: 1.5; color: #e02a46; margin: 0 0 0.8rem; }
  .intro-inner p.motto-tr { font-family: var(--font-section); font-weight: 700; font-size: 25px; line-height: 1.4; color: #020450; margin: 0; }
  @media (max-width: 640px) { .intro-inner p.motto-ja { font-size: 22px; } .intro-inner p.motto-tr { font-size: 18px; } }
  :global(.p-hero .subtitle) { text-shadow: 0 0 6px rgba(0,0,0,0.9), 0 2px 4px rgba(0,0,0,0.9); }
  .breadcrumb-wrap { padding-top: 1rem; padding-bottom: 0; }

  .intro {
    background: var(--color-bg);
    padding: 3rem 1.5rem 2rem;
  }
  .intro-inner {
    max-width: 800px;
    margin: 0 auto;
  }
  .intro-inner p {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 17px;
    line-height: 1.75;
    color: #2a2a2a;
    margin: 0 0 1.3rem;
  }
  .intro-inner p.dedication {
    font-family: 'Akaya Telivigala', serif;
    font-weight: 500;
    font-size: 20px;
    color: #020450;
    text-align: center;
    margin: 0.5rem auto 2rem;
    max-width: 720px;
  }

  .intro-inner hr.navy-rule {
    border: none;
    border-top: 1px solid #999;
    opacity: 0.5;
    margin: 2.2rem 0;
  }

  .intro-inner h2.section-q {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 28px;
    color: var(--color-accent);
    text-align: center;
    line-height: 1.3;
    margin: 1rem 0 1.5rem;
  }
  .intro-inner p.sub-q {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 18px;
    color: var(--color-navy);
    text-align: center;
    margin: 0.3rem 0;
  }
  .intro-inner p.lead-quote {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 16px;
    color: #2a2a2a;
    text-align: center;
    max-width: 720px;
    margin: 1.5rem auto 0;
  }

  .intro-inner em { font-style: italic; }
  .intro-inner strong { font-weight: 400; color: var(--color-navy); }
  .intro-inner a { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid currentColor; }
  .intro-inner a strong { color: inherit; }
  .intro-inner a:hover { color: var(--color-navy); }

  .war-block {
    padding: 3rem 1.5rem 2rem;
    max-width: 1280px;
    margin: 0 auto;
  }
  .war-title {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 30px;
    color: var(--color-accent);
    text-align: center;
    margin: 1rem 0 2rem;
    letter-spacing: 0.03em;
  }

  .kw-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem 2.5rem;
  }
  .kw-card {
    display: block;
    text-decoration: none;
    color: inherit;
    text-align: center;
    transition: transform 0.25s ease;
  }
  .kw-card:hover { transform: translateY(-2px); }
  .kw-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 2px;
    margin: 0 auto 1rem;
    max-width: 240px;
  }
  .kw-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 0.25s ease;
  }
  .kw-card:hover .kw-image img { filter: brightness(1.05); }
  .kw-cardtitle {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 18px;
    color: var(--color-navy);
    margin: 0 0 0.6rem;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }
  .kw-desc {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #444;
    margin: 0;
  }

  .pw-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem 2.5rem;
  }
  .pw-card.pw-card-static { cursor: default; }
  .pw-card.pw-card-static:hover { transform: none; }
  .pw-card.pw-card-static:hover .pw-image img { filter: none; }
  .pw-card {
    display: block;
    text-decoration: none;
    color: inherit;
    text-align: center;
    transition: transform 0.25s ease;
  }
  .pw-card:hover { transform: translateY(-2px); }
  .pw-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 2px;
    margin: 0 auto 1rem;
    max-width: 240px;
  }
  .pw-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pw-cardtitle {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 19px;
    color: var(--color-navy);
    margin: 0 0 0.6rem;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }
  .pw-desc {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #444;
    margin: 0;
  }
  hr.section-divider {
    border: none;
    border-top: 6px solid #8a8b6a;
    max-width: 1280px;
    margin: 1rem auto;
    opacity: 0.7;
  }

  .memorials {
    padding: 3rem 1.5rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .mem-tagline {
    font-family: Helvetica, Arial, sans-serif;
    font-weight: 600;
    font-size: 19px;
    color: var(--color-navy);
    text-align: center;
    margin: 0 0 3rem;
  }

  .mem-item {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 2.5rem;
    margin: 0 0 4rem;
    align-items: start;
  }
  .mem-item.mem-item-reverse {
    grid-template-columns: 1fr 320px;
  }
  .mem-item.mem-item-reverse .mem-image { order: 2; }
  .mem-item.mem-item-reverse .mem-body { order: 1; }

  .mem-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }
  .mem-body p {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.75;
    color: #2a2a2a;
    margin: 0 0 1.2rem;
  }
  .mem-body a { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid currentColor; }
  .mem-body a:hover { color: var(--color-navy); }
  .mem-title {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 22px;
    color: var(--color-accent);
    margin: 0 0 1.2rem;
    letter-spacing: 0.02em;
  }
  .mem-sub {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 17px;
    color: var(--color-navy);
    margin: 1.8rem 0 0.6rem;
    letter-spacing: 0.04em;
  }
  .mem-links {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #2a2a2a;
    padding-left: 1.2rem;
    margin: 0 0 1.2rem;
  }
  .mem-aux {
    margin: 1rem 0 0;
    max-width: 360px;
  }
  .mem-aux img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid rgba(0,0,0,0.1);
  }

  @media (max-width: 900px) {
    .kw-grid { grid-template-columns: repeat(2, 1fr); }
    .pw-grid { grid-template-columns: 1fr; }
    .mem-item,
    .mem-item.mem-item-reverse {
      grid-template-columns: 1fr;
    }
    .mem-item.mem-item-reverse .mem-image { order: 0; }
    .mem-item.mem-item-reverse .mem-body { order: 0; }
  }
  @media (max-width: 600px) {
    .kw-grid { grid-template-columns: 1fr; }
    .intro-inner h2.section-q { font-size: 26px; }
    .war-title { font-size: 28px; }
  }
</style>
