  .ind-table th { background: #020450; color: #fff; text-align: left; padding: 8px 10px; font-weight: 700; }
  .ind-table td { border-bottom: 1px solid #ccc; padding: 10px; vertical-align: top; }
  .ind-table tr:last-child td { background: rgba(224,42,70,0.08); }
  .rock-maps { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 0 0 2rem; }
  .rock-maps img { width: 100%; height: auto; display: block; }
  @media (max-width: 640px) { .rock-maps { grid-template-columns: 1fr; } }
  .intro-inner p.signature { text-align: right; font-style: italic; }
  .rock-main { --color-accent: #e02a46; }
  .motto { text-align: center; margin: 0.5rem auto 2rem; max-width: 760px; }
