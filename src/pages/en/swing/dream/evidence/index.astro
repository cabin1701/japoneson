    margin: 1.2rem 0 0;
    text-align: right;
    font-size: 0.8rem;
  }
  .essay-inner p.back-to-toc {
    font-size: 0.8rem;
    margin: 1.2rem 0 0;
  }
  .back-to-toc a {
    color: #888;
    text-decoration: none;
  }
  .back-to-toc a:hover {
