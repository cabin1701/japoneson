  }
  .record-photo {
    margin: 0.6rem auto 1.4rem;
    max-width: 460px;
    text-align: center;
  }
  .record-photo img {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.25);
    cursor: zoom-in;
  }
