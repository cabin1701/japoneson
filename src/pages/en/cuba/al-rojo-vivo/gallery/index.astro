---
import Layout from '../../../../../layouts/Layout.astro';
import Header from '../../../../../components/Header.astro';
import Footer from '../../../../../components/Footer.astro';
import Breadcrumb from '../../../../../components/Breadcrumb.astro';
import ProjectHero from '../../../../../components/ProjectHero.astro';

const base = import.meta.env.BASE_URL;
const mediaBase = 'https://cdn.jsdelivr.net/gh/cabin1701/site-media@main/japoneson/cuba/al-rojo-vivo/gallery';

const trail = [
  { slug: 'cuba', title: 'JAPONÉSON', path: `${base}en/cuba/` },
  { slug: 'rip-papi', title: 'RIP Papi', path: `${base}en/cuba/rip-papi/` },
  { slug: 'gallery', title: 'AL ROJO', path: `${base}en/cuba/al-rojo-vivo/gallery/` },
];

const captions: Record<number, string> = {
  1: "Papi (far left) with fellow cadets at the Escuela de Cadetes 'General Antonio Maceo,' posed by the monument.",
  2: "Papi's certificate for his internationalist military service in Ethiopia, signed by Fidel Castro, 1979 — the origin of the name 'Rojo' behind the wall graffiti 'AL ROJO VIVO.'",
  3: "Papi's wedding day.",
  4: 'A young Papi.',
  5: 'Outside an art school in Guanabacoa with his daughter Daniela, 2015.',
  6: "Papi's mother.",
  7: 'A photo of Danny that Papi kept close.',
  8: 'Veterans in Playa Girón, 2017.',
  9: 'Visiting my house in Cojímar, 2017.',
  10: "With Daniela's daughter, his granddaughter Tania, 2017.",
  11: 'An afternoon in Guanabacoa, 2017.',
  12: 'Out with Daniela and the kids, 2017.',
  13: 'Greeting a neighbor in Guanabacoa, 2017.',
  14: 'Papi posing with his guitar for the camera, 2016.',
  15: 'Papi playing guitar on the floor — an everyday scene, 2016.',
  16: "Papi's birthday party, at a relative's house, 2018.",
  17: 'Daniela as a little girl, with her close friend Manolo.',
  18: 'Papi’s refrigerator, covered in photos — and a welcome sign for Shoko, Cupie, and Danny.',
  19: "Inside Papi's house — my photo was there too, 2016.",
  20: "Sai Baba, the Indian guru, somehow in Papi's house, 2016.",
  21: 'Holding my CD up to the TV screen — not sure why, 2017.',
  22: 'He wanted to try Japanese sake, a souvenir from Japan, 2017.',
  23: 'Papi always cooked for us, 2015.',
  24: "Papi's cooking — congrí that day, 2016.",
  25: 'Papi cooking for a friend visiting from New York, 2015.',
  26: "Papi's cooking, 2016.",
  27: 'Happily talking on the phone with his daughter in Miami, 2018.',
  28: 'Jessi, who lives near me in Cojímar, invited Papi over, 2018.',
  29: "Papi's birthday — his daughter Daniela on his lap, singing together, 2018.",
  30: "On the phone with Danny, the brother he'd never met — though the line wasn't really connected, 2015.",
  31: "Papi's ration book, with photos of Danny and Danny's mother, 2015.",
  32: 'Papi and Cupie Danny, wearing the white shirt Danny sent him, 2016.',
  33: 'About to see me off to the airport, 2015.',
  34: 'At José Martí International Airport, 2015.',
  35: 'Daniela and her son Erik, 2016.',
  36: "Papi and me, in Luisito's living room in Cojímar, 2018.",
  37: "At the home of Papi's close friend Carida, by the sea in Guanabo, 2015.",
  38: 'Walking through Guanabacoa, 2017.',
  39: 'Erik and Papi, at the beach in Guanabo, 2015.',
  40: 'Erik, scared — it was his first time at the beach, 2015.',
  41: 'Papi appearing on a radio show in Havana, 2017.',
  42: 'On the way back from the radio show, Papi stopped to listen to music on Obispo Street, 2017.',
  43: "Papi's house — AL ROJO VIVO.",
  44: 'Out to buy supplies needed for a Santería ceremony, 2017.',
  45: "At Daniela's house, holding his granddaughter Tania, 2017.",
  46: 'A Santería priest in Guanabacoa, 2017.',
  47: 'The Guanabacoa museum, where Santería history is on display — Guanabacoa is that kind of place, 2015.',
  48: 'Papi cooking the first meal he ever made for us. He always seemed happy shaping the rice into its mold, 2015.',
};

const photos = Array.from({ length: 48 }, (_, i) => i + 1).map((n) => ({
  n,
  caption: captions[n] ?? 'Papi — a photo from his life in Cuba.',
}));
---

<Layout title="AL ROJO — Papi Photo Gallery — Japonéson" description="48 photos of Papi (Antonio Rojo)'s life in Cuba — military school, family, cooking, Santería, and more." lang="en" ogImage="images/cuba/al-rojo-vivo/hero-al-rojo.jpg">
  <Header lang="en" />
  <main>
    <ProjectHero
      title="AL ROJO"
      titleFont="var(--font-display-cinzel)"
      titleWeight={700}
      titleSize="52px"
      glow="light"
      image={`${base}images/cuba/al-rojo-vivo/hero-al-rojo.jpg`}
      imageAlt="Papi crouching beside a toddler on the beach, waves behind them."
      align="center"
      height={640}
      fit="cover"
      overlayTop={0}
      overlayBottom={0.35}
    />

    <div class="container breadcrumb-wrap">
      <Breadcrumb trail={trail} lang="en" />
    </div>

    <section class="gallery-wrap al-rojo-gallery">
      <div class="gallery-grid">
        {photos.map(({ n, caption }) => (
          <div class="g-image">
            <img src={`${mediaBase}/g${String(n).padStart(2, '0')}.jpg`} alt={caption} data-caption={caption} loading="lazy" />
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer lang="en" />
</Layout>

<style>
  .breadcrumb-wrap { padding-top: 1rem; padding-bottom: 0; }

  .gallery-wrap {
    padding: 1rem 1.5rem 4rem;
    max-width: 1280px;
    margin: 0 auto;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .g-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 2px;
    cursor: zoom-in;
  }
  .g-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms ease;
  }
  .g-image:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 1000px) {
    .gallery-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 720px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const gallery = document.querySelector('.al-rojo-gallery');
    if (!gallery) return;
    const box = document.createElement('div');
    box.className = 'al-rojo-lightbox';
    const figure = document.createElement('figure');
    const big = document.createElement('img');
    const figcaption = document.createElement('figcaption');
    figure.appendChild(big);
    figure.appendChild(figcaption);
    box.appendChild(figure);
    document.body.appendChild(box);
    gallery.querySelectorAll('img').forEach((img) => {
      img.addEventListener('click', () => {
        const el = img as HTMLImageElement;
        big.src = el.currentSrc || el.src;
        figcaption.textContent = el.dataset.caption || '';
        box.classList.add('open');
      });
    });
    box.addEventListener('click', () => box.classList.remove('open'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') box.classList.remove('open');
    });
  });
</script>

<style is:global>
  .al-rojo-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.85);
    display: none;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
    padding: 2rem;
  }
  .al-rojo-lightbox.open {
    display: flex;
  }
  .al-rojo-lightbox figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 90vw;
    max-height: 90vh;
  }
  .al-rojo-lightbox img {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.5);
  }
  .al-rojo-lightbox figcaption {
    color: #f5f5f5;
    font-size: 0.95rem;
    text-align: center;
    margin-top: 0.75rem;
    max-width: 60ch;
  }
</style>
