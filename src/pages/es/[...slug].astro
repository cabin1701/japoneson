---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import { buildPath, buildBreadcrumb } from '../../lib/pageTree';
import { deriveExcerpt } from '../../lib/excerpt';

export async function getStaticPaths() {
  // URL paths that have their own crafted index.astro page (avoid route collision).
  // Uses full path (not just slug) so e.g. /es/murakami/kyoko/ (the film hub)
  // can be crafted while /es/murakami/music/kyoko/ and /es/murakami/tosco/kyoko/
  // continue to render via the dynamic route.
  const CRAFTED_PATHS = new Set([
    'home',
    'cuba',
    'murakami',
    'murakami/tosco',
    'murakami/music',
    'murakami/kyoko',
    'murakami/books',
    'swing',
    'swing/dream',
    'swing/remember',
    'mystery',
    'mystery/macarthur',
    'mystery/meiji',
    'mystery/hieke',
    'mystery/macarthur/korea-24th',
    'mystery/macarthur/korea-black-soldiers',
    'mystery/macarthur/david-valley',
    'mystery/macarthur/donald-versaw',
    'cupie',
    'cupie/gallery-01',
    'cupie/gallery-02',
    'cupie/gallery-03',
  ]);
  const all = await getCollection('es');
  return all
    .filter((e) => !CRAFTED_PATHS.has(buildPath(e, all)))
    .map((entry) => ({
      params: { slug: buildPath(entry, all) },
      props: { entry, all },
    }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const trail = buildBreadcrumb(entry, all, import.meta.env.BASE_URL);
const metaDescription = deriveExcerpt(entry.body);
---

<Layout title={`${entry.data.title} — Japonéson`} lang="es" description={metaDescription} ogImage={entry.data.hero_image}>
  <Header lang="es" />
  {(entry.data.hero_image || (entry.data.hero_slideshow && entry.data.hero_slideshow.length > 0)) && (
    <ProjectHero
      kicker={entry.data.hero_kicker}
      title={entry.data.title}
      subtitle={entry.data.hero_subtitle}
      image={entry.data.hero_image}
      imageAlt={entry.data.hero_image_alt}
      align="center"
      height={entry.data.hero_height ?? 480}
      fit={entry.data.hero_fit ?? 'cover'}
      videoId={entry.data.hero_video}
      videoStart={entry.data.hero_video_start}
      videoSound={entry.data.hero_video_sound}
      titleFont={entry.data.hero_title_font}
      titleWeight={entry.data.hero_title_weight}
      titleItalic={entry.data.hero_title_italic}
      titleSize={entry.data.hero_title_size}
      titleColor={entry.data.hero_title_color}
      glow={entry.data.hero_glow}
      titleHidden={entry.data.hero_title_hidden}
      slideshow={entry.data.hero_slideshow}
      slideshowDuration={entry.data.hero_slideshow_duration}
    />
  )}
  <main class={`container page-${entry.data.slug}${buildPath(entry, all).startsWith('murakami/music/') ? ' page-album' : ''}${buildPath(entry, all).startsWith('swing/remember/') ? ' page-booklet' : ''}${buildPath(entry, all).startsWith('mystery/meiji/') ? ' page-meiji' : ''}`}>
    <Breadcrumb trail={trail} lang="es" />
    <article>
      {!(entry.data.hero_image || (entry.data.hero_slideshow && entry.data.hero_slideshow.length > 0)) && <h1>{entry.data.title}</h1>}
      <Content />
    </article>
  </main>
  <Footer lang="es" />
</Layout>

<script is:inline>
  // Content-collection pages: click a data-zoom image to view it enlarged.
  document.addEventListener('DOMContentLoaded', () => {
    const triggers = document.querySelectorAll('article img[data-zoom]');
    if (!triggers.length) return;
    const box = document.createElement('div');
    box.className = 'article-lightbox';
    const big = document.createElement('img');
    box.appendChild(big);
    document.body.appendChild(box);
    triggers.forEach((trigger) => {
      trigger.style.cursor = 'zoom-in';
      trigger.addEventListener('click', () => {
        big.src = trigger.currentSrc || trigger.src;
        big.alt = trigger.alt;
        box.classList.add('open');
      });
    });
    box.addEventListener('click', () => box.classList.remove('open'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') box.classList.remove('open');
    });
  });
</script>

<style is:global>
  .article-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.85);
    padding: 2rem;
    cursor: zoom-out;
  }
  .article-lightbox.open {
    display: flex;
  }
  .article-lightbox img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
</style>
