---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import ProjectHero from '../../../../components/ProjectHero.astro';
import SubGrid from '../../../../components/SubGrid.astro';
import type { SubCard } from '../../../../components/SubGrid.astro';

const base = import.meta.env.BASE_URL;
const IMG = (p: string) => `/images/wp/${p}`;

const pressBase = 'https://cdn.jsdelivr.net/gh/cabin1701/site-media@main/japoneson/angels-swing/press';
const press = [
  { f: '1999-07-09-mainichi.jpg', c: 'Mainichi Shimbun · 9 jul 1999' },
  { f: '1999-07-28-asahi.jpg', c: 'Asahi Shimbun · 28 jul 1999' },
  { f: '1999-07-31-nikkei.jpg', c: 'Nikkei · 31 jul 1999' },
  { f: '1999-07-31-kumamoto-nichinichi.jpg', c: 'Kumamoto Nichinichi Shimbun · 31 jul 1999' },
  { f: '1999-08-03-nishinihon.jpg', c: 'Nishinippon Shimbun · 3 ago 1999' },
  { f: '1999-nishinihon.jpg', c: 'Nishinippon Shimbun · 1999' },
  { f: '1999-09-28-mainichi-daily-news.jpg', c: 'The Mainichi Daily News · 28 sep 1999' },
  { f: '1999-12-19-asahi.jpg', c: 'Asahi Shimbun · 19 dic 1999' },
  { f: '1999-11-19-yomiuri-america.jpg', c: 'Yomiuri America · 19 nov 1999' },
  { f: '1999-shukan-yomiuri.jpg', c: 'Shukan Yomiuri · 1999' },
  { f: '1999-toyama.jpg', c: 'Toyama Shimbun · 1999' },
  { f: '2000-02-24-josei-seven-1.jpg', c: 'Josei Seven · 24 feb 2000 (1/4)' },
  { f: '2000-02-24-josei-seven-2.jpg', c: 'Josei Seven · 24 feb 2000 (2/4)' },
  { f: '2000-02-24-josei-seven-3.jpg', c: 'Josei Seven · 24 feb 2000 (3/4)' },
  { f: '2000-02-24-josei-seven-4.jpg', c: 'Josei Seven · 24 feb 2000 (4/4)' },
  { f: '2000-yomiuri-america.jpg', c: 'Yomiuri America · 2000' },
];

const subCards: SubCard[] = [
  {
    title: 'From Ryu Murakami',
    image: IMG('2026/05/ryu-1.jpg'),
    imageAlt: 'From Ryu Murakami',
    description: '',
    href: '/es/swing/dream/ryu/',
  },
  {
    title: 'Letters From Nursing Homes',
    image: IMG('2026/05/letters.jpg'),
    imageAlt: 'Letters From Nursing Homes',
    description: '.',
    href: '/es/swing/dream/letters/',
  },
];

const trail = [
  { slug: 'swing', title: 'ANGELS SWING', path: `${base}es/swing/` },
  { slug: 'dream', title: 'I HAVE A DREAM… SEINA', path: `${base}es/swing/dream/` },
];
---

<Layout title='I Have a Dream… Seina — Japonéson' description="Un regalo de canciones a 3.500 residencias de mayores en Estados Unidos, nacido en 1992 de un disco llamado G.I. Jo y una grabación de Jo Stafford." lang="es" ogImage="images/swing/hero_dream.jpg">
  <Header lang="es" />
  <main>
    <ProjectHero
      kicker="LAS CANCIONES PARA LOS ASILOS DE ANCIANOS EN EE. UU."
      title="I Have a Dream… Seina"
      subtitle="3500 asilos de ancianos en Estados Unidos — un regalo de canciones."
      image={`${base}images/swing/hero_dream.jpg`}
      align="center"
      height={900}
      fit="cover"
      titleFont='"Cormorant Infant", serif'
      titleWeight={700}
      titleItalic={true}
      titleColor="#a6cef1"
      titleSize="85px"
    />

    <div class="container breadcrumb-wrap">
      <Breadcrumb trail={trail} lang="es" />
    </div>

    <div class="container top-video-wrap">
      <div class="video-wrap top-video">
        <iframe
          src="https://www.youtube.com/embed/videoseries?list=PLdol6bNKBui14Dlq_aVcZb6KahHATc4KM"
          title="I Have a Dream... Seina"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <section class="essay">
      <div class="essay-inner">
        <h2>Angel&apos;s Swing &amp; Associates</h2>
        <p class="letter-date">Diciembre de 1999</p>

        <p>Estimada residencia de ancianos en los EE. UU.:</p>
        <p>
          Este es mi sueño…<br />
          Envío este sueño a 3500 residencias de ancianos en los EE. UU.
        </p>
        <p>
          En 1992 encontré un álbum llamado G.I. Jo. En él había una grabación de JO STAFFORD, una de las cantantes más populares durante la Segunda Guerra Mundial. En ese álbum, ella cantaba sobre la guerra y sobre la vida de aquella época. Esas canciones se apoderaron de mi corazón. Desde entonces centré mi atención en la música de la época de la Segunda Guerra Mundial y escuché muchas de esas canciones. Para alguien nacida mucho después de la guerra, era difícil comprender el sentir de aquel tiempo. La música de esa época era muy bella, romántica y sentimental. Y reflejaba el sentimiento de los años de guerra, cuando los amantes tenían que separarse y rezaban por volver a encontrarse. Podía sentir que no les quedaba más remedio que rezar. A través de estas canciones pude comprender las penas y las emociones que vivió aquella gente.
        </p>
        <p>
          Hay canciones que todavía hoy se aman y se atesoran. Sin embargo, hay algunas canciones que la gente ha olvidado. Además, hay canciones que perduran hoy, pero que no se aprecian por su verdadero significado ni por la época de la que provienen.<br />
          La razón por la que esas canciones perduran hoy es, probablemente, la gran cantidad de oraciones puestas en ellas.
        </p>
        <p>
          Como cantante que ama de verdad la música de esta época, deseaba grabar estas canciones con mis oraciones, con la ayuda de músicos que vivieron en aquel tiempo. Y decidí enviarlas a residencias de ancianos en los EE. UU. como regalo de Navidad, en 1999.
        </p>
        <p>
          Quiero decirles que sus canciones siguen respirando y vivas. Sé que Japón y los EE. UU. estuvieron enfrentados durante la Segunda Guerra Mundial. Pero ahora quiero que sepan que esas canciones todavía son amadas por muchas personas en Japón.
        </p>
        <p>
          Para quienes aún sienten dolor al recordar aquel tiempo, ofrezco este álbum, con calidez, con amor… y con mis oraciones.
        </p>
        <p>Y… aquí está mi regalo de Navidad para las personas de las residencias de ancianos.</p>
        <p class="letter-close">
          Muy atentamente,<br />
          Shoko “Seina” Shiraishi
        </p>
        <p>P. D. Visiten mi sitio, por favor; allí hay más información y mensajes míos…</p>

        <figure class="letter-scan">
          <img
            src="https://cdn.jsdelivr.net/gh/cabin1701/site-media@main/japoneson/angels-swing/letter-to-nursing-homes-1999.jpg"
            alt="La carta que Seina incluyó con el álbum, enviada a las residencias de ancianos en diciembre de 1999"
            data-zoom
            loading="lazy"
          />
          <figcaption>Haz clic para ampliar</figcaption>
        </figure>
        <hr class="navy-rule" />

        <div class="musicians">
          <p>Leonard Gaskin (contrabajo),</p>
          <p>Artie Baker (Clarinete y Saxo Tenor),</p>
          <p>Toya (piano),</p>
          <p>Grady Tate (batería),</p>
          <p>Ron Roulier (piano),</p>
          <p>Howard Kimbo (Saxo Tenor)</p>
          <p>Seina (Voz)</p>
        </div>

        <div class="album-block">
          <div class="album-cover">
            <img
              src={`${base}images/wp/2026/05/CDjacket-1024x1024.jpg`}
              alt="I Have a Dream… Seina — carátula del CD"
              loading="lazy"
            />
          </div>
          <div class="album-tracklist">
            <h3>Lista de Canciones</h3>
            <ol class="tracklist">
              <li><span class="track-title">I'll Walk Alone</span><span class="track-time">5:10</span></li>
              <li><span class="track-title">I Left My Heart at the Stage Door Canteen</span><span class="track-time">3:43</span></li>
              <li><span class="track-title">We'll Be Together Again</span><span class="track-time">3:34</span></li>
              <li><span class="track-title">P.S. I Love You</span><span class="track-time">5:00</span></li>
              <li><span class="track-title">A Nightingale Sang in Berkeley Square</span><span class="track-time">5:50</span></li>
              <li><span class="track-title">Sentimental Journey</span><span class="track-time">3:10</span></li>
              <li><span class="track-title">It's Been a Long, Long Time</span><span class="track-time">4:34</span></li>
              <li><span class="track-title">We Mustn't Say Goodbye</span><span class="track-time">4:16</span></li>
              <li><span class="track-title">I'll Be Seeing You</span><span class="track-time">4:37</span></li>
              <li><span class="track-title">White Christmas</span><span class="track-time">2:31</span></li>
            </ol>
          </div>
        </div>

      </div>
    </section>

    <div class="subgrid-narrow">
    <hr class="navy-rule" />
      <SubGrid cards={subCards} columns={2} />
    </div>

    <section class="press-section">
      <div class="press-inner">
        <hr class="navy-rule" />
        <h2>En la prensa</h2>
        <p class="press-note">
          Entre julio de 1999 y febrero de 2000, el proyecto apareció en periódicos
          nacionales y regionales de todo Japón y en la prensa en japonés de Nueva York.
          Fue una cantidad de atención inusual para algo iniciado por una persona
          particular. El plan empezó en 4300 residencias y se ajustó a 3500 por el
          coste — y 3500 ya era una tarea enorme.
        </p>
        <div class="video-wrap press-video">
          <iframe
            src="https://www.youtube-nocookie.com/embed/FY-yB9-tC8U"
            title="Christmas Gift for nursing homes in the U.S. (1999)"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
        <div class="press-grid">
          {press.map(({ f, c }) => (
            <figure>
              <img src={`${pressBase}/${f}`} alt={c} data-zoom loading="lazy" />
              <figcaption>{c}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer lang="es" />
</Layout>

<style>
  .breadcrumb-wrap {
    padding-top: 1.5rem;
    padding-bottom: 0.5rem;
  }

  .subgrid-narrow {
    max-width: 35%;
    margin: 0 auto;
  }
  @media (max-width: 900px) {
    .subgrid-narrow { max-width: 55%; }
  }
  @media (max-width: 720px) {
    .subgrid-narrow { max-width: 100%; }
  }

  .essay {
    padding: 2rem 1.5rem 3rem;
  }
  .essay-inner {
    max-width: 760px;
    margin: 0 auto;
  }
  .essay-inner h2 {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 24px;
    color: var(--color-accent);
    margin: 1.5rem 0 0.5rem;
    text-align: center;
  }
  .essay-inner p {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 17px;
    line-height: 1.75;
    color: #2a2a2a;
    margin: 0 0 1.2rem;
  }
  .essay-inner p.letter-date {
    text-align: right;
    margin-bottom: 2rem;
  }
  .essay-inner p.letter-close {
    margin-top: 2rem;
  }
  .letter-scan {
    margin: 2.5rem auto 0;
    max-width: 240px;
  }
  .letter-scan img {
    width: 100%;
    display: block;
    border: 1px solid #ddd;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    cursor: zoom-in;
    transition: transform 200ms ease;
  }
  .letter-scan img:hover {
    transform: scale(1.03);
  }
  .letter-scan figcaption {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 13px;
    color: #888;
    text-align: center;
    margin-top: 0.6rem;
  }

  .musicians {
    margin: 2.5rem 0;
    text-align: center;
  }
  .musicians p {
    font-family: var(--font-display-cinzel);
    font-size: 16px;
    color: var(--color-navy);
    margin: 0.3rem 0;
    line-height: 1.5;
  }

  .album-block {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
    justify-content: center;
    margin: 2.5rem 0;
  }
  .album-cover img {
    width: 260px;
    max-width: 100%;
    display: block;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
  }
  .album-tracklist {
    flex: 1;
    max-width: 360px;
  }
  .album-tracklist h3 {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 18px;
    color: var(--color-accent);
    margin: 0 0 0.8rem;
  }
  .tracklist {
    list-style: decimal;
    margin: 0;
    padding-left: 1.3rem;
  }
  .tracklist li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: Helvetica, Arial, sans-serif;
    font-size: 15px;
    color: #2a2a2a;
    padding: 0.35rem 0;
    border-bottom: 1px solid #e8e8e8;
  }
  .tracklist li:last-child {
    border-bottom: none;
  }
  .track-time {
    color: #888;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .album-block {
      flex-direction: column;
      align-items: center;
    }
    .album-tracklist {
      max-width: 100%;
      width: 100%;
    }
  }

  .video-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 2rem 0;
  }
  .top-video-wrap {
    max-width: 560px;
    padding-top: 1.5rem;
  }
  .top-video-wrap .video-wrap {
    margin: 0 0 2rem;
  }
  .video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 720px) {
    .essay-inner h2 { font-size: 20px; }
  }

  .press-section {
    padding: 1rem 1.5rem 4rem;
  }
  .press-inner {
    max-width: 1000px;
    margin: 0 auto;
  }
  .press-inner h2 {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 24px;
    color: var(--color-accent);
    margin: 1.5rem 0 0.5rem;
    text-align: center;
  }
  .press-note {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #555;
    max-width: 640px;
    margin: 0 auto 1.5rem;
    text-align: center;
  }
  .press-video {
    max-width: 640px;
    margin: 0 auto 2.5rem;
  }
  .press-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem 1rem;
  }
  .press-grid figure {
    margin: 0;
  }
  .press-grid img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
    display: block;
    border: 1px solid #ddd;
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.12);
    cursor: zoom-in;
    transition: transform 200ms ease;
  }
  .press-grid img:hover {
    transform: scale(1.03);
  }
  .press-grid figcaption {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 12px;
    color: #888;
    text-align: center;
    margin-top: 0.5rem;
    line-height: 1.4;
  }
  @media (max-width: 900px) {
    .press-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 560px) {
    .press-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const triggers = document.querySelectorAll<HTMLImageElement>('img[data-zoom]');
    if (!triggers.length) return;
    const box = document.createElement('div');
    box.className = 'letter-lightbox';
    const big = document.createElement('img');
    box.appendChild(big);
    document.body.appendChild(box);
    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        big.src = trigger.currentSrc || trigger.src;
        big.alt = trigger.alt;
        box.classList.add('open');
      });
    });
    box.addEventListener('click', () => box.classList.remove('open'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') box.classList.remove('open');
    });
  });
</script>

<style is:global>
  .letter-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.85);
    display: none;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
    padding: 2rem;
  }
  .letter-lightbox.open {
    display: flex;
  }
  .letter-lightbox img {
    max-width: 92vw;
    max-height: 92vh;
    width: auto;
    height: auto;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
  }
</style>
