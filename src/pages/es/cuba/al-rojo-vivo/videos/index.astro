---
import Layout from '../../../../../layouts/Layout.astro';
import Header from '../../../../../components/Header.astro';
import Footer from '../../../../../components/Footer.astro';
import Breadcrumb from '../../../../../components/Breadcrumb.astro';
import ProjectHero from '../../../../../components/ProjectHero.astro';

const base = import.meta.env.BASE_URL;

const trail = [
  { slug: 'cuba', title: 'JAPONÉSON', path: `${base}es/cuba/` },
  { slug: 'rip-papi', title: 'RIP Papi', path: `${base}es/cuba/rip-papi/` },
  { slug: 'videos', title: 'VIVO', path: `${base}es/cuba/al-rojo-vivo/videos/` },
];
---

<Layout title="VIVO — Papi en movimiento — Japonéson" description="Videos de Papi (Antonio Rojo), una figura paterna cubana recordada a través de Japonéson." lang="es" ogImage="images/cuba/al-rojo-vivo/hero-vivo.jpg">
  <Header lang="es" />
  <main>
    <ProjectHero
      title="VIVO"
      titleFont="var(--font-display-cinzel)"
      titleWeight={700}
      titleSize="52px"
      glow="light"
      image={`${base}images/cuba/al-rojo-vivo/hero-vivo.jpg`}
      imageAlt="Papi con una boina del Che Guevara, guitarra al hombro, cantando entre la familia."
      align="center"
      height={640}
      fit="cover"
      overlayTop={0}
      overlayBottom={0.35}
    />

    <div class="container breadcrumb-wrap">
      <Breadcrumb trail={trail} lang="es" />
    </div>

    <div class="container coming-soon">
      <p>Próximamente</p>
    </div>
  </main>
  <Footer lang="es" />
</Layout>

<style>
  .breadcrumb-wrap { padding-top: 1rem; padding-bottom: 2rem; }
  .coming-soon {
    padding: 2rem 1.5rem 6rem;
    text-align: center;
    font-size: 1.1rem;
    color: var(--color-text-secondary, #666);
  }
</style>
