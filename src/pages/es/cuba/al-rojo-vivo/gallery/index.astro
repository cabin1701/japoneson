---
import Layout from '../../../../../layouts/Layout.astro';
import Header from '../../../../../components/Header.astro';
import Footer from '../../../../../components/Footer.astro';
import Breadcrumb from '../../../../../components/Breadcrumb.astro';
import ProjectHero from '../../../../../components/ProjectHero.astro';

const base = import.meta.env.BASE_URL;
const mediaBase = 'https://cdn.jsdelivr.net/gh/cabin1701/site-media@main/japoneson/cuba/al-rojo-vivo/gallery';

const trail = [
  { slug: 'cuba', title: 'JAPONÉSON', path: `${base}es/cuba/` },
  { slug: 'rip-papi', title: 'RIP Papi', path: `${base}es/cuba/rip-papi/` },
  { slug: 'gallery', title: 'AL ROJO', path: `${base}es/cuba/al-rojo-vivo/gallery/` },
];

const captions: Record<number, string> = {
  45: 'Su nieta Tania — la única foto que tenemos de ella, 2017.',
  46: 'Un sacerdote de la Santería en Guanabacoa, 2017.',
  47: 'El museo de Guanabacoa, donde se expone la historia de la Santería — Guanabacoa es ese tipo de lugar, 2015.',
  48: 'Papi cocinando la primera comida que nos hizo. Siempre parecía feliz dando forma al arroz en el molde, 2015.',
};

const photos = Array.from({ length: 48 }, (_, i) => i + 1).map((n) => ({
  n,
  caption: captions[n] ?? 'Papi — una foto de su vida en Cuba.',
}));
---

<Layout title="AL ROJO — Galería de fotos de Papi — Japonéson" description="Una galería de fotos de Papi (Antonio Rojo), una figura paterna cubana recordada a través de Japonéson." lang="es" ogImage="images/cuba/al-rojo-vivo/hero-al-rojo.jpg">
  <Header lang="es" />
  <main>
    <ProjectHero
      title="AL ROJO"
      titleFont="var(--font-display-cinzel)"
      titleWeight={700}
      titleSize="52px"
      glow="light"
      image={`${base}images/cuba/al-rojo-vivo/hero-al-rojo.jpg`}
      imageAlt="Papi agachado junto a un bebé en la playa, con las olas detrás."
      align="center"
      height={640}
      fit="cover"
      overlayTop={0}
      overlayBottom={0.35}
    />

    <div class="container breadcrumb-wrap">
      <Breadcrumb trail={trail} lang="es" />
    </div>

    <section class="gallery-wrap al-rojo-gallery">
      <div class="gallery-grid">
        {photos.map(({ n, caption }) => (
          <div class="g-image">
            <img src={`${mediaBase}/g${String(n).padStart(2, '0')}.jpg`} alt={caption} data-caption={caption} loading="lazy" />
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer lang="es" />
</Layout>

<style>
  .breadcrumb-wrap { padding-top: 1rem; padding-bottom: 0; }

  .gallery-wrap {
    padding: 1rem 1.5rem 4rem;
    max-width: 1280px;
    margin: 0 auto;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .g-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 2px;
    cursor: zoom-in;
  }
  .g-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms ease;
  }
  .g-image:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 1000px) {
    .gallery-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 720px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const gallery = document.querySelector('.al-rojo-gallery');
    if (!gallery) return;
    const box = document.createElement('div');
    box.className = 'al-rojo-lightbox';
    const figure = document.createElement('figure');
    const big = document.createElement('img');
    const figcaption = document.createElement('figcaption');
    figure.appendChild(big);
    figure.appendChild(figcaption);
    box.appendChild(figure);
    document.body.appendChild(box);
    gallery.querySelectorAll('img').forEach((img) => {
      img.addEventListener('click', () => {
        const el = img as HTMLImageElement;
        big.src = el.currentSrc || el.src;
        figcaption.textContent = el.dataset.caption || '';
        box.classList.add('open');
      });
    });
    box.addEventListener('click', () => box.classList.remove('open'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') box.classList.remove('open');
    });
  });
</script>

<style is:global>
  .al-rojo-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.85);
    display: none;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
    padding: 2rem;
  }
  .al-rojo-lightbox.open {
    display: flex;
  }
  .al-rojo-lightbox figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 90vw;
    max-height: 90vh;
  }
  .al-rojo-lightbox img {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.5);
  }
  .al-rojo-lightbox figcaption {
    color: #f5f5f5;
    font-size: 0.95rem;
    text-align: center;
    margin-top: 0.75rem;
    max-width: 60ch;
  }
</style>
