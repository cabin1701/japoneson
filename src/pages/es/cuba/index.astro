---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ProjectHero from '../../../components/ProjectHero.astro';

const base = import.meta.env.BASE_URL;
const IMG = (p: string) => `/images/wp/${p}`;

interface KCard {
  title: string;
  image: string;
  alt: string;
  desc: string;
  href: string;
}

const CD_JACKET = '/images/wp/2026/05/jk-400.jpg';

const entryCards: KCard[] = [
  {
    title: 'Antes de la Revolución',
    image: `https://cdn.jsdelivr.net/gh/cabin1701/site-media@main/japoneson/cuba/pre-revolution/bauza-afrocubans-1947.jpg`,
    alt: 'Mario Bauzá tocando la trompeta con la sección rítmica de los Afro-Cubans, 1947',
    desc: 'Donde la música cubana se encontró con el jazz',
    href: `${base}es/cuba/pre-revolution/`,
  },
  {
    title: 'Archivo de Música Cubana',
    image: CD_JACKET,
    alt: 'Archivo de Música Cubana',
    desc: 'Próximamente',
    href: `${base}es/cuba/`,
  },
  {
    title: 'Línea Doméstica',
    image: CD_JACKET,
    alt: 'Línea Doméstica',
    desc: 'Próximamente',
    href: `${base}es/cuba/`,
  },
  {
    title: 'Línea del Exilio',
    image: CD_JACKET,
    alt: 'Línea del Exilio',
    desc: 'Próximamente',
    href: `${base}es/cuba/`,
  },
  {
    title: 'Notas de Investigación',
    image: CD_JACKET,
    alt: 'Notas de Investigación',
    desc: 'Próximamente',
    href: `${base}es/cuba/`,
  },
  {
    title: 'Fuentes Primarias',
    image: CD_JACKET,
    alt: 'Fuentes Primarias',
    desc: 'Próximamente',
    href: `${base}es/cuba/`,
  },
  {
    title: 'Por La Chocolate',
    image: CD_JACKET,
    alt: 'Por La Chocolate',
    desc: '(2017)',
    href: `${base}es/cuba/por-la-chocolate/`,
  },
];

const trail = [
  { slug: 'cuba', title: 'JAPONÉSON', path: `${base}es/cuba/` },
];
---

<Layout title="JAPONÉSON — Japonéson" description="Estudio de la música posrevolucionaria de los cubanos — línea doméstica, exilio, puente hacia el futuro." lang="es" ogImage="images/cuba/hero_malecon-sunset.jpg">
  <Header lang="es" />
  <main>
    <ProjectHero
      kicker="Estudio de la música posrevolucionaria de los cubanos"
      title="JAPONÉSON"
      subtitle="Línea doméstica, exilio, puente hacia el futuro"
      titleFont="var(--font-display-cinzel)"
      titleWeight={700}
      titleSize="60px"
      image={`${base}images/cuba/hero_malecon-sunset.jpg`}
      imageAlt="La Habana. Atardecer en el Malecón. Al otro lado del mar está Estados Unidos."
      align="center"
      height={1000}
      fit="cover"
      overlayTop={0}
      overlayBottom={0.35}
    />

    <div class="container breadcrumb-wrap">
      <Breadcrumb trail={trail} lang="es" />
    </div>

    <section class="intro">
      <div class="intro-inner">
        <p class="dedication">
          Dedico este capítulo a mi papá cubano, Antonio Rojo (Papi), que está en el cielo, quien
          apoyó y sostuvo mi vida en Cuba. Era un hombre que amaba la música más que nadie.
        </p>

        <hr class="navy-rule" />

        <h2 class="section-q">Ricky ❤︎ Ricardo<br/></h2>

        <figure class="ricky-photo">
          <img src={`https://cdn.jsdelivr.net/gh/cabin1701/site-media@main/japoneson/cuba/ricky-ricardo-charm.jpg`} alt="Un brazalete de dijes y una bolsita Vera Bradley, ambos con Ricky Ricardo y Lucy de I Love Lucy." loading="lazy" />
        </figure>

        <p class="sub-q">Mi primer encuentro con un cubano exiliado fue Ricky Ricardo, interpretado por Desi Arnaz en “I Love Lucy”.</p>
        <p class="sub-q">Me enamoré de este director de orquesta con su acento tan marcado.</p>
        <p class="lead-quote">
         Por supuesto, no sabía nada sobre Cuba, los Estados Unidos ni siquiera sobre la música cubana.
        </p>

        <hr class="navy-rule" />

        <a class="essay-link" href={`${base}es/cuba/how-it-began/`} aria-label="Leer: Cómo empezó este proyecto">
          <img class="essay-link-img essay-link-blue" src={`${base}images/cuba/how-it-began/hero-blue-es.jpg`} alt="Cómo empezó este proyecto" />
          <img class="essay-link-img essay-link-red" src={`${base}images/cuba/how-it-began/hero-red-es.jpg`} alt="" aria-hidden="true" />
        </a>

        <hr class="navy-rule" />

         <h2 class="section-q">Una Puerta en East Harlem<br/></h2>

        <p>
          Otoño de 2013. Estaba pasando una temporada en Nueva York, y a través de la ventana de un restaurante en Spanish Harlem, vi a Danny Rojo.
        </p>

        <p>
          ¿¿¿Qué es esto???
        </p>

        <p>
          En el mundo del jazz que yo había conocido, y en la comunidad japonesa de Nueva York, no entrabas en la cultura hispana a menos que te interesara de verdad. Que no salgas el día del desfile puertorriqueño, que es peligroso... cosas así. Un amigo mío fue asaltado y murió. El hombre que lo mató era puertorriqueño. Un amigo que vivía a tres cuadras de mí. Dentro de su apartamento.
        </p>

        <p>
          Así que había un muro entre la cultura latina y yo.
        </p>

        <p>
          Pero ese día, se abrió una puerta.
        </p>

        <p>
          Al año siguiente vi un llavero de cupie en una tienda de cien yenes y, por pura travesura, hice el Cupie Danny. Y el Cupie Danny terminó metiéndose entre los músicos cubanos — con el dedo gordo del pie por delante.
        </p>

        <p>
          Sin saber español, sin conocer la música cubana, sin saber quiénes eran los músicos cubanos famosos, llamé a Carlos Varela, a Issac Delgado, a Edesio Alejandro. Porque Danny me dijo que fuera a entregárselos.
        </p>

        <div class="big-names-grid">
          <figure>
            <img src={`https://cdn.jsdelivr.net/gh/cabin1701/site-media@main/japoneson/cuba/big-names/carlos-varela.jpg`} alt="Carlos Varela con el llavero y la tarjeta de Cupie Danny." loading="lazy" />
            <figcaption>Carlos Varela</figcaption>
          </figure>
          <figure>
            <img src={`https://cdn.jsdelivr.net/gh/cabin1701/site-media@main/japoneson/cuba/big-names/issac-delgado.jpg`} alt="Issac Delgado sonriendo con el llavero y la tarjeta de Cupie Danny." loading="lazy" />
            <figcaption>Issac Delgado</figcaption>
          </figure>
          <figure>
            <img src={`https://cdn.jsdelivr.net/gh/cabin1701/site-media@main/japoneson/cuba/big-names/edesio-alejandro.jpg`} alt="Edesio Alejandro sonriendo con la tarjeta de Cupie Danny, afuera de un edificio colonial en La Habana." loading="lazy" />
            <figcaption>Edesio Alejandro</figcaption>
          </figure>
        </div>

        <p>
          Y con ese dedo gordo todavía metido, espié su mundo, solo un poquito. Pero eso no me bastó, así que saqué una visa de estudiante y me fui a vivir a Cuba. Porque si no vivía allí, había cosas que no podía ver — no lograba agarrar ni una brizna de comprensión.
        </p>

        <p>
          Me enamoré de ese país incómodo.<br/>
          Porque es incómodo, conocí la comida hecha en casa — esa que no se puede hacer sin dedicarle tiempo.
        </p>

        <p>
          Porque era incómodo, y había tiempo, hablábamos despacio. Quizá había tiempo para escuchar mi español malísimo.
        </p>

        <p>
          La música era una lengua dentro de la vida diaria, y Papi siempre con la guitarra en una mano, lanzándome palabras, cantándome. A veces era pesado, eso sí.
        </p>

        <p>
          Papi estaba orgulloso de haber combatido en Playa Girón, en Bahía de Cochinos.<br/>
          Danny odiaba la política de Cuba.
        </p>

        <p>
          Pero los dos amaban la música.<br/>
          Yo también amo la música.
        </p>
      </div>
    </section>

    <hr class="section-divider" />

    <section class="war-block">
      <div class="pw-grid">
        {entryCards.map((c) => (
          <a class="pw-card" href={c.href}>
            <div class="pw-image"><img src={c.image} alt={c.alt} loading="lazy" /></div>
            <h3 class="pw-cardtitle">{c.title}</h3>
            <p class="pw-desc">{c.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <hr class="section-divider" />

    <section class="intro">
      <div class="intro-inner desi-block">
        <h2 class="war-title">Desi Arnaz</h2>

        <p class="lead">
          A Ricky Ricardo lo interpretaba un hombre que de verdad había perdido su país.
        </p>

        <p>
          Desiderio Alberto Arnaz III nació en Santiago de Cuba en 1917. Su padre fue el alcalde más joven que tuvo Santiago, y más tarde ocupó un escaño en la Cámara de Representantes de Cuba.
        </p>

        <p>
          En 1933 cayó el gobierno de Machado. Encarcelaron a su padre y le confiscaron todo lo que la familia tenía. Ese agosto quemaron y saquearon su casa. El padre logró salir antes hacia Miami, donde montó una empresa de importación y exportación con otros dos refugiados, y en junio de 1934 <strong>Desi llegó a Estados Unidos, con diecisiete años.</strong>
        </p>

        <p>
          Esto no fue una mudanza. <strong>Fue exilio — el movimiento de alguien a quien le habían quemado la casa a sus espaldas.</strong>
        </p>

        <p>
          Conviene tenerlo claro. Esta <strong>no</strong> fue la revolución de 1959. Fue la caída de Machado en 1933, veintiséis años antes.
        </p>

        <p>
          Después vendría el gran éxito de "Babalú", y la fundación de Desilu Productions — el estudio que años más tarde llevaría <em>Star Trek</em> a la televisión.
        </p>

        <p>
          Fue uno de los primeros exiliados cubanos en llegar al centro de la cultura popular estadounidense. Para muchísimos estadounidenses de los años cincuenta, aquel director de orquesta de acento marcado en su televisor fue el único cubano que conocerían nunca.
        </p>

        <div class="video">
          <iframe src="https://www.youtube.com/embed/y-OSS0kBDV8?si=3TfcBBoWqYBnZKew" title="I Love Lucy" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        </div>
      </div>
    </section>

    <hr class="section-divider" />

    <section class="war-block">
      <h2 class="war-title">Proyectos Relacionados</h2>
      <div class="pw-grid">
        <a class="pw-card" href={`${base}es/murakami/`}>
          <div class="pw-image"><img src={IMG('2026/05/murakami02-1024x1020.jpg')} alt="Murakami Mambo" loading="lazy" /></div>
          <h3 class="pw-cardtitle">Murakami Mambo</h3>
        </a>
        <a class="pw-card" href={`${base}es/cupie/`}>
          <div class="pw-image"><img src={IMG('2026/02/raibowd03-1-scaled-e1771762858743-1-600x567.jpg')} alt="Cupie Danny" loading="lazy" /></div>
          <h3 class="pw-cardtitle">Cupie Danny</h3>
        </a>
        <a class="pw-card" href={`${base}es/swing/leonard-gaskin/brooklyn-bop/`}>
          <div class="pw-image"><img src="/images/swing/leonard-purejazz.jpg" alt="The Brooklyn Bop Brothers" loading="lazy" /></div>
          <h3 class="pw-cardtitle">The Brooklyn Bop Brothers</h3>
        </a>
      </div>
    </section>
  </main>
  <Footer lang="es" />
</Layout>

<style>
  .breadcrumb-wrap { padding-top: 1rem; padding-bottom: 0; }

  .intro {
    background: var(--color-bg);
    padding: 3rem 1.5rem 2rem;
  }
  .intro-inner {
    max-width: 800px;
    margin: 0 auto;
  }
  .intro-inner p {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 17px;
    line-height: 1.75;
    color: #2a2a2a;
    margin: 0 0 1.3rem;
  }
  .intro-inner p.dedication {
    font-family: 'Akaya Telivigala', serif;
    font-weight: 500;
    font-size: 20px;
    color: #020450;
    text-align: center;
    margin: 0.5rem auto 2rem;
    max-width: 720px;
  }

  .intro-inner hr.navy-rule {
    border: none;
    border-top: 1px solid #999;
    opacity: 0.5;
    margin: 2.2rem 0;
  }

  .intro-inner h2.section-q {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 28px;
    color: var(--color-accent);
    text-align: center;
    line-height: 1.3;
    margin: 1rem 0 1.5rem;
  }
  .intro-inner p.sub-q {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 18px;
    color: var(--color-navy);
    text-align: center;
    margin: 0.3rem 0;
  }
  .intro-inner p.lead-quote {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 16px;
    color: #2a2a2a;
    text-align: center;
    max-width: 720px;
    margin: 1.5rem auto 0;
  }

  .intro-inner em { font-style: italic; }
  .intro-inner strong { font-weight: 400; color: var(--color-navy); }
  .intro-inner a { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid currentColor; }
  .intro-inner a:hover { color: var(--color-navy); }

  .ricky-photo {
    margin: 2rem auto 0;
    max-width: 307px;
  }
  .ricky-photo img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }

  .essay-link {
    position: relative;
    display: block;
    max-width: 420px;
    margin: 1.8rem auto 0;
  }
  .essay-link-img {
    width: 100%;
    height: auto;
    display: block;
  }
  .essay-link-red {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .essay-link:hover .essay-link-red,
  .essay-link:focus-visible .essay-link-red {
    opacity: 1;
  }
  .essay-link a:hover { color: var(--color-navy); }

  .big-names-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 720px;
    margin: 1.6rem auto 2rem;
  }
  .big-names-grid figure {
    margin: 0;
  }
  .big-names-grid img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    border-radius: 2px;
  }
  .big-names-grid figcaption {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 13px;
    color: #555;
    text-align: center;
    margin-top: 0.5rem;
  }
  @media (max-width: 600px) {
    .big-names-grid { grid-template-columns: 1fr; max-width: 320px; }
  }

  .desi-block strong { font-weight: 700; color: #2a2a2a; }
  .desi-block p.lead {
    font-size: 19px;
    color: var(--color-navy);
  }
  .desi-block .video {
    position: relative;
    width: 100%;
    max-width: 640px;
    aspect-ratio: 16 / 9;
    margin: 1.8rem auto 0.5rem;
  }
  .desi-block .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 2px;
  }

  .war-block {
    padding: 3rem 1.5rem 2rem;
    max-width: 1280px;
    margin: 0 auto;
  }
  .war-title {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 30px;
    color: var(--color-accent);
    text-align: center;
    margin: 1rem 0 2rem;
    letter-spacing: 0.03em;
  }

  .kw-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem 2.5rem;
  }
  .kw-card {
    display: block;
    text-decoration: none;
    color: inherit;
    text-align: center;
    transition: transform 0.25s ease;
  }
  .kw-card:hover { transform: translateY(-2px); }
  .kw-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 2px;
    margin: 0 auto 1rem;
    max-width: 240px;
  }
  .kw-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 0.25s ease;
  }
  .kw-card:hover .kw-image img { filter: brightness(1.05); }
  .kw-cardtitle {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 18px;
    color: var(--color-navy);
    margin: 0 0 0.6rem;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }
  .kw-desc {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #444;
    margin: 0;
  }

  .pw-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem 2.5rem;
  }
  .pw-card.pw-card-static { cursor: default; }
  .pw-card.pw-card-static:hover { transform: none; }
  .pw-card.pw-card-static:hover .pw-image img { filter: none; }
  .pw-card {
    display: block;
    text-decoration: none;
    color: inherit;
    text-align: center;
    transition: transform 0.25s ease;
  }
  .pw-card:hover { transform: translateY(-2px); }
  .pw-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 2px;
    margin: 0 auto 1rem;
    max-width: 240px;
  }
  .pw-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pw-cardtitle {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 19px;
    color: var(--color-navy);
    margin: 0 0 0.6rem;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }
  .pw-desc {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #444;
    margin: 0;
  }
  hr.section-divider {
    border: none;
    border-top: 6px solid #8a8b6a;
    max-width: 1280px;
    margin: 1rem auto;
    opacity: 0.7;
  }

  .memorials {
    padding: 3rem 1.5rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .mem-tagline {
    font-family: Helvetica, Arial, sans-serif;
    font-weight: 600;
    font-size: 19px;
    color: var(--color-navy);
    text-align: center;
    margin: 0 0 3rem;
  }

  .mem-item {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 2.5rem;
    margin: 0 0 4rem;
    align-items: start;
  }
  .mem-item.mem-item-reverse {
    grid-template-columns: 1fr 320px;
  }
  .mem-item.mem-item-reverse .mem-image { order: 2; }
  .mem-item.mem-item-reverse .mem-body { order: 1; }

  .mem-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }
  .mem-body p {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.75;
    color: #2a2a2a;
    margin: 0 0 1.2rem;
  }
  .mem-body a { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid currentColor; }
  .mem-body a:hover { color: var(--color-navy); }
  .mem-title {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 22px;
    color: var(--color-accent);
    margin: 0 0 1.2rem;
    letter-spacing: 0.02em;
  }
  .mem-sub {
    font-family: var(--font-display-cinzel);
    font-weight: 600;
    font-size: 17px;
    color: var(--color-navy);
    margin: 1.8rem 0 0.6rem;
    letter-spacing: 0.04em;
  }
  .mem-links {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #2a2a2a;
    padding-left: 1.2rem;
    margin: 0 0 1.2rem;
  }
  .mem-aux {
    margin: 1rem 0 0;
    max-width: 360px;
  }
  .mem-aux img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid rgba(0,0,0,0.1);
  }

  @media (max-width: 900px) {
    .kw-grid { grid-template-columns: repeat(2, 1fr); }
    .pw-grid { grid-template-columns: 1fr; }
    .mem-item,
    .mem-item.mem-item-reverse {
      grid-template-columns: 1fr;
    }
    .mem-item.mem-item-reverse .mem-image { order: 0; }
    .mem-item.mem-item-reverse .mem-body { order: 0; }
  }
  @media (max-width: 600px) {
    .kw-grid { grid-template-columns: 1fr; }
    .intro-inner h2.section-q { font-size: 26px; }
    .war-title { font-size: 28px; }
  }
</style>
