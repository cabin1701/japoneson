---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title='404 — Shoko "Seina" Shiraishi' lang="en">
  {/*
    旧 WordPress サイトの URL を新構造へ寄せる受け皿。
    GitHub Pages は未解決パスに /404.html を返すため、ここがフォールバックになる。

    (1) 旧 /ryu/* ツリー（introduction, works/books, works/music, cuba/tosco,
        cuba/kyoko …）→ 新サイトでは /{lang}/murakami/ の 4 ページ
        （books / music / kyoko / tosco）＋ハブに集約。キーワードで最適ページへ、
        該当なければハブへ。
    (2) 旧 /angelsswing/* → スラッグ短縮で /{lang}/swing/* に。構造は 1:1 なので
        パスを保持したまま angelsswing を swing に置換。
    言語プレフィックスが無い／日本語(ja)の旧 URL は英語版へ寄せる。
  */}
  <script is:inline>
    (function () {
      var p = decodeURIComponent(location.pathname).toLowerCase();
      var lm = p.match(/^\/(es|en)\//);
      var lang = lm ? lm[1] : 'en';

      // (1) 旧 angelsswing/* → swing/*（パス保持、angelsswing を丸ごとセグメント一致）
      //     ※ ryu 判定より先に。angelsswing/dream/ryu は swing 配下のエッセイであって
      //       Ryu Murakami セクションではないため、ここで先に捕まえる。
      var am = p.match(/\/angelsswing(\/.*)?$/);
      if (am) {
        var rest = am[1] || '';
        var d = '/' + lang + '/swing' + rest;
        if (d.charAt(d.length - 1) !== '/') d += '/';
        location.replace(d);
        return;
      }

      // (2) 旧 Ryu Murakami ツリー（/ryu というパスセグメントを含む）
      if (/(^|\/)ryu(\/|$)/.test(p)) {
        var base = '/' + lang + '/murakami/';
        var dest = base;
        if (p.indexOf('tosco') !== -1) dest = base + 'tosco/';
        else if (p.indexOf('kyoko') !== -1) dest = base + 'kyoko/';
        else if (p.indexOf('music') !== -1) dest = base + 'music/';
        else if (p.indexOf('books') !== -1 || p.indexOf('reference') !== -1) dest = base + 'books/';
        location.replace(dest);
        return;
      }
    })();
  </script>

  <Header lang="en" />
  <main class="notfound">
    <img
      class="notfound-image"
      src="https://cdn.jsdelivr.net/gh/cabin1701/site-media@main/japoneson/404/cupie-danny-teacup.jpg"
      alt="Cupie Danny, a small figure with a rainbow beard, peeking out of a teacup"
      width="1000"
      height="750"
    />

    <p class="notfound-code">404</p>

    <div class="notfound-lines">
      <p class="notfound-line">
        <span class="notfound-msg">I'm Cupie Danny. The page you were looking for isn't here. Come play at my house.</span>
        <a class="notfound-link" href="/en/cupie/">japoneson.com/en/cupie/</a>
      </p>
      <p class="notfound-line">
        <span class="notfound-msg">Soy Cupie Danny. La página que buscabas no está aquí. Ven a jugar a mi casa.</span>
        <a class="notfound-link" href="/es/cupie/">japoneson.com/es/cupie/</a>
      </p>
    </div>

    <p class="notfound-home">
      <a href="/en/">English home</a>
      <a href="/es/">Inicio en español</a>
    </p>
  </main>
  <Footer lang="en" />
</Layout>

<style>
  .notfound {
    max-width: 860px;
    margin: 2.5rem auto 4rem;
    padding: 0 1.5rem;
    text-align: center;
  }

  .notfound-image {
    display: block;
    width: 100%;
    height: auto;
    max-width: 420px;
    margin: 0 auto;
    border-radius: 8px;
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.22);
  }

  .notfound-code {
    font-size: clamp(2.4rem, 8vw, 4rem);
    color: var(--color-accent);
    margin: 1.5rem 0 0.5rem;
    letter-spacing: 0.08em;
  }

  .notfound-lines {
    max-width: 560px;
    margin: 0 auto;
  }

  .notfound-line {
    margin: 0 0 1.2rem;
    line-height: 1.7;
  }

  .notfound-msg {
    display: block;
    color: var(--color-text);
    font-size: 1.1rem;
  }

  .notfound-link {
    display: inline-block;
    margin-top: 0.2rem;
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    font-size: 0.95rem;
  }

  .notfound-home {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 2rem;
  }
</style>
