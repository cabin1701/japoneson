---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const TURNSTILE_SITEKEY = '0x4AAAAAAEz2JHrB_7IosZnP';
const CONTACT_ENDPOINT = 'https://newsletter.cabin1701.com/contact';
---

<Layout title='お問い合わせ — Japonéson' lang="ja" description="Japonéson へのお問い合わせ。">
  <Header lang="ja" />
  <main class="container">
    <h1>お問い合わせ</h1>
    <div class="crew-notice">
      <p><strong>Cabin1701 の通信窓口へようこそ。</strong></p>
      <p><em>（Japonéson と Seina の文学・音楽のアーカイブへのお便りは、<a href="https://cabin1701.com/about/">Cabin1701</a> がここで受け取り、お預かりしています。）</em></p>
      <p>Seina の日々の暮らしと創作を守るため、<strong>まず Cabin1701 の AI クルーがここで受け取ります。</strong></p>
      <p>届いたお便りはすべて読み、大切な点を Seina に届けます。</p>
      <p>ご感想、ご質問、資料のことなどを、わかりやすくお書きください。あたたかく正直な言葉が、いちばん遠くまで届きます。</p>
    </div>

    <form id="contact-form" class="contact-form">
      <label for="contact-name">お名前</label>
      <input id="contact-name" name="name" type="text" required maxlength="200" />

      <label for="contact-email">メールアドレス</label>
      <input id="contact-email" name="email" type="email" required maxlength="320" />

      <label for="contact-subject">件名</label>
      <input id="contact-subject" name="subject" type="text" required maxlength="200" />

      <label for="contact-message">本文</label>
      <textarea id="contact-message" name="message" rows="8" required maxlength="5000"></textarea>

      <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY}></div>

      <button type="submit">送信</button>
      <p id="contact-status" role="status" aria-live="polite"></p>
    </form>
  </main>
  <Footer lang="ja" />
</Layout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script define:vars={{ CONTACT_ENDPOINT }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('contact-status');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = '送信しています…';

    const formData = new FormData(form);
    const turnstileToken = formData.get('cf-turnstile-response');

    if (!turnstileToken) {
      status.textContent = '確認（ロボットでないことの確認）を済ませてください。';
      return;
    }

    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      subject: formData.get('subject'),
      message: formData.get('message'),
      turnstileToken,
    };

    try {
      const res = await fetch(CONTACT_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('failed');
      form.hidden = true;
      status.textContent = 'ありがとうございます。送信しました。お返事をお待ちください。';
    } catch {
      status.textContent = 'うまく送れませんでした。少し時間をおいて、もう一度お試しください。';
    }
  });
</script>

<style>
  main.container {
    max-width: 720px;
    margin: 3rem auto 4rem;
    padding: 0 1.5rem;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 520px;
    margin-top: 1.5rem;
  }
  .contact-form label {
    font-weight: 600;
    margin-top: 0.8rem;
  }
  .contact-form input,
  .contact-form textarea {
    font: inherit;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--color-muted, #999);
    border-radius: 4px;
    background: var(--color-bg, #fff);
    color: var(--color-text, #222);
  }
  .contact-form button {
    margin-top: 1.2rem;
    align-self: flex-start;
    padding: 0.6rem 1.6rem;
    border: none;
    border-radius: 4px;
    background: var(--color-accent, #c0397a);
    color: #fff;
    font-weight: 600;
    cursor: pointer;
  }
  .contact-form button:hover {
    opacity: 0.9;
  }
  #contact-status {
    margin-top: 0.8rem;
    font-size: 0.95rem;
  }
  .crew-notice {
    max-width: 520px;
    margin-top: 1.5rem;
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--color-accent, #c0397a);
    background: rgba(0, 0, 0, 0.03);
    font-size: 0.95rem;
  }
  .crew-notice p {
    margin: 0 0 0.6rem;
  }
  .crew-notice p:last-child {
    margin-bottom: 0;
  }
</style>
